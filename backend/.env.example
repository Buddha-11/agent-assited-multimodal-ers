LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT=45
LLM_REQUIRE_API_KEY=true
LLM_RESPONSE_FORMAT=json_schema
LLM_REASONING_EFFORT=low
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_EMOTION_MODEL=speechbrain/emotion-recognition-wav2vec2-IEMOCAP
AUDIO_DEVICE=auto
FACE_FRAME_INTERVAL=1
DATABASE_URL=sqlite:///./data/emotion_agent.db
MAX_RECORDING_SECONDS=30
MAX_UPLOAD_MB=25
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional system binaries; bundled imageio FFmpeg is used if absent.
FFMPEG_PATH=
# DeepFace uses CPU independently; PyTorch can still use CUDA.
HF_HOME=./.cache/huggingface
DEEPFACE_HOME=./.cache
